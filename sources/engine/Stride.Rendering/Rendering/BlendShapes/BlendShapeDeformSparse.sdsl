/// <summary>
/// GPU compute shader for sparse blend shape (morph target) vertex deformation.
///
/// SPARSE CSR LAYOUT:
///
///   Storage is vertex-major (Compressed Sparse Row):
///     VertexContribOffset[v]  → first index in the flat contribution arrays for vertex v
///     VertexContribCount[v]   → number of shapes that affect vertex v
///     ContribShapeIndices[i]  → which target (shape) this entry belongs to
///     ContribPosDeltas[i]     → float3 position delta for this entry
///     ContribNrmDeltas[i]     → float3 normal delta for this entry
///     ContribTanDeltas[i]     → float3 tangent delta for this entry
///
///   Each thread owns one vertex and reads only its own short contribution list.
///   Vertices with no blendshape influence (ContribCount = 0) exit immediately.
///
/// WHY SPARSE BEATS DENSE HERE:
///
///   Dense layout stores deltas for ALL vertices per target, even zeros.
///   Sparse stores only the (typically 2–15 %) that are non-zero.
///   For a 8 k-vert mesh, 50 shapes, 5 % avg coverage:
///     Dense bandwidth: 50 × 8000 × 12 B = 4.8 MB per dispatch
///     Sparse bandwidth: 50 × 400 × 12 B = 240 KB per dispatch  (~20× less)
///   Dead-zone culling at cook time removes a further 15–40 % of entries.
///
/// WEIGHT MAP:
///
///   AllWeights[shapeIdx] holds all target weights (full array, not just active).
///   The shader skips any contribution whose shape has |w| < epsilon — this handles
///   shapes that are in the sparse data but currently at weight 0 with no extra
///   CPU-side compaction step. Uploading the full weight array costs ~200 B for a
///   50-shape rig — negligible compared with the VRAM savings.
///
/// ACCURACY:
///
///   Visually identical to the dense shader. Same float32 maths, same normalize,
///   same byte-level output vertex buffer format. No precision is sacrificed.
/// </summary>
#ifndef ThreadNumberX
# define ThreadNumberX 64
#endif
#ifndef ThreadNumberY
# define ThreadNumberY 1
#endif
#ifndef ThreadNumberZ
# define ThreadNumberZ 1
#endif
shader BlendShapeDeformSparse : ComputeShaderBase
{
    // --- Input: base vertex attributes (bind pose, uploaded once at init) ---
    stage StructuredBuffer<float3> BasePositions;
    stage StructuredBuffer<float3> BaseNormals;
    stage StructuredBuffer<float3> BaseTangents;

    // --- CSR per-vertex contribution table ---
    stage StructuredBuffer<uint> VertexContribOffset;
    stage StructuredBuffer<uint> VertexContribCount;

    // --- Flat per-contribution data (ordered vertex by vertex) ---
    stage StructuredBuffer<uint>   ContribShapeIndices;
    stage StructuredBuffer<float3> ContribPosDeltas;
    stage StructuredBuffer<float3> ContribNrmDeltas;
    stage StructuredBuffer<float3> ContribTanDeltas;

    // --- Full target weight array (all shapes, indexed by original target index) ---
    stage StructuredBuffer<float> AllWeights;

    // --- Output: interleaved vertex buffer (same buffer used by draw calls) ---
    stage RWByteAddressBuffer OutputVertexBuffer;

    // --- Uniforms ---
    cbuffer BlendShapeSparseParams
    {
        stage int VertexCount;      // total vertices in the base mesh
        stage int VertexStride;     // output VB stride in bytes
        stage int PositionOffset;   // byte offset of POSITION in vertex stride
        stage int NormalOffset;     // byte offset of NORMAL in vertex stride
        stage int TangentOffset;    // byte offset of TANGENT in vertex stride (-1 if absent)
    };

    override void Compute()
    {
        uint vertexId = streams.DispatchThreadId.x;
        if (vertexId >= (uint)VertexCount)
            return;

        // Load base attributes once — paid for every vertex regardless of contributions.
        float3 pos = BasePositions[vertexId];
        float3 nrm = BaseNormals[vertexId];
        float3 tan = float3(0, 0, 0);
        bool hasTan = TangentOffset >= 0;
        if (hasTan)
            tan = BaseTangents[vertexId];

        uint start = VertexContribOffset[vertexId];
        uint count = VertexContribCount[vertexId];

        // Accumulate only the shapes that actually affect this vertex.
        // The loop body is reached at most ~3–15 times for a typical facial vertex;
        // vertices with no influence (count == 0) skip the loop entirely.
        for (uint j = start; j < start + count; j++)
        {
            uint shapeIdx = ContribShapeIndices[j];
            float w = AllWeights[shapeIdx];

            // Skip shapes that are currently at zero weight (active check at runtime).
            if (abs(w) < 0.0001)
                continue;

            pos += ContribPosDeltas[j] * w;
            nrm += ContribNrmDeltas[j] * w;
            if (hasTan)
                tan += ContribTanDeltas[j] * w;
        }

        // Normalise direction vectors — same as dense shader.
        nrm = normalize(nrm);
        if (hasTan)
            tan = normalize(tan);

        // Write to the interleaved output vertex buffer at the correct byte offsets.
        uint baseAddr = vertexId * (uint)VertexStride;
        OutputVertexBuffer.Store3(baseAddr + (uint)PositionOffset, asuint(pos));
        OutputVertexBuffer.Store3(baseAddr + (uint)NormalOffset, asuint(nrm));
        if (hasTan)
            OutputVertexBuffer.Store3(baseAddr + (uint)TangentOffset, asuint(tan));
    }
};
